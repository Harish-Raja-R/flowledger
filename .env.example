# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Use MongoDB Atlas connection string in cloud)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/flowledger?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/flowledger

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_string_in_production
